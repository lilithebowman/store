# Server Configuration
NODE_ENV=development
PORT=2048
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=store_db

# Security - Generate these with: node -p "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=your_very_long_random_jwt_secret_string_here_64_chars_minimum
SESSION_SECRET=your_very_long_random_session_secret_string_here_32_chars_minimum

# OAuth Configuration (if using)
OAUTH_CLIENT_ID=your_google_client_id
OAUTH_CLIENT_SECRET=your_google_client_secret
OAUTH_CALLBACK_URL=http://localhost:2048/auth/google/callback

# CORS Configuration
REACT_APP_API_URL=http://localhost:2048/api
