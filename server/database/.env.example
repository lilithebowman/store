# Database Abstraction Layer Configuration Examples
# Copy the relevant section to your .env file

# =============================================================================
# MySQL Configuration (Default)
# =============================================================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=yourpassword
DB_LOGGING=true
DB_AUTO_CREATE=true

# Alternative: Use connection URL for MySQL
# DATABASE_URL=mysql://root:yourpassword@localhost:3306/ecommerce_db

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecommerce_db
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_LOGGING=true

# Alternative: Use connection URL for PostgreSQL
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/ecommerce_db

# =============================================================================
# SQLite Configuration
# =============================================================================
# DB_TYPE=sqlite
# DB_NAME=ecommerce_db.sqlite
# DB_LOGGING=true

# Alternative: Use connection URL for SQLite
# DATABASE_URL=sqlite:./ecommerce_db.sqlite

# =============================================================================
# MongoDB Configuration
# =============================================================================
# DB_TYPE=mongodb
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=ecommerce_db
# DB_USER=mongouser
# DB_PASSWORD=mongopassword
# DB_LOGGING=true

# Alternative: Use connection URL for MongoDB
# DATABASE_URL=mongodb://mongouser:mongopassword@localhost:27017/ecommerce_db

# =============================================================================
# MariaDB Configuration
# =============================================================================
# DB_TYPE=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ecommerce_db
# DB_USER=mariadb
# DB_PASSWORD=yourpassword
# DB_LOGGING=true

# =============================================================================
# Connection Pool Settings (for SQL databases)
# =============================================================================
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# =============================================================================
# Legacy Environment Variables (for backwards compatibility)
# =============================================================================
# These are still supported but DB_* variables take precedence
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=yourpassword

# =============================================================================
# Other Application Settings
# =============================================================================
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-session-secret-here
PORT=2048
