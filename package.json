{
	"name": "e-commerce-platform",
	"description": "A full-stack e-commerce application built with React, Node.js, and MySQL.",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"concurrently": "^6.5.1",
		"cors": "^2.8.5",
		"dotenv": "^16.5.0"
	},
	"scripts": {
		"start": "npm run dev",
		"client:start": "npm start --prefix client",
		"client:build": "npm run build --prefix client",
		"client:test": "npm run test --prefix client",
		"client:eject": "npm run eject --prefix client",
		"prepare": "husky install",
		"client": "npm start --prefix client",
		"server": "npm start --prefix server",
		"dev": "concurrently \"npm run client\" \"npm run server\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:coverage:ci": "jest --coverage --watchAll=false --passWithNoTests",
		"coverage:check": "./scripts/check-coverage.sh",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
		"format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@babel/core": "^7.27.4",
		"@babel/preset-env": "^7.27.2",
		"@babel/preset-react": "^7.27.1",
		"@testing-library/jest-dom": "^5.17.0",
		"@testing-library/react": "^13.4.0",
		"@testing-library/user-event": "^13.5.0",
		"babel-jest": "^30.0.2",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.1.3",
		"husky": "^9.1.7",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^27.5.1",
		"jest-transform-stub": "^2.0.0",
		"lint-staged": "^15.5.2",
		"prettier": "^3.2.4",
		"react-scripts": "5.0.1"
	},
	"lint-staged": {
		"client/src/**/*.{js,jsx,ts,tsx,json,css,scss}": [
			"prettier --write"
		],
		"client/src/**/*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		],
		"server/src/**/*.{js,jsx,ts,tsx,json,css,scss}": [
			"prettier --write"
		],
		"server/src/**/*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		]
	}
}
